var
  integer n, d, isPrime;

main
  output("Primes up to 30:")
  n = 2;
  while (n <= 30) loop
    isPrime = 1;
    d = 2;
    while (d * d <= n and isPrime == 1) loop
      if (n % d == 0) then
        isPrime = 0;
      end if
      d = d + 1;
    end loop
    if (isPrime == 1) then
      output(n)
    end if
    n = n + 1;
  end loop
end
