var
  integer i, j, count;
main
  i = 1;
  while (i <= 3) loop
    j = 1;
    while (j <= 3) loop
      if (i == j) then
        count = count + 1;
      else
        if (i < j) then
          count = count + 10;
        end if
      end if
      j = j + 1;
    end loop
    i = i + 1;
  end loop
  output(count)
end
